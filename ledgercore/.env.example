# Owner/migration connection — used only by the Prisma CLI (migrate/generate).
DATABASE_URL="postgresql://ledgercore:ledgercore@localhost:5432/ledgercore?schema=public"

# Runtime app connection — non-superuser role so Row-Level Security applies.
# See prisma/migrations/20260710130200_app_role.
APP_DATABASE_URL="postgresql://ledgercore_app:ledgercore_app@localhost:5432/ledgercore?schema=public"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"
PORT=3000
